# AIPCC configuration. Copy to .env and you are done:
#
#   cp .env.example .env
#   docker compose up
#
# Every value below has a working local default, so the stack comes up with no
# edits. Add an LLM key only when you want to generate a *new* report — the
# seeded demo reports need none.
#
# .env is gitignored. Never commit real values.
# Every variable here is read in exactly one place: backend/app/core/config.py.
# docker compose also reads this file: it passes it into the backend container
# and uses it for ${VAR} substitution in docker-compose.yml.

# --- App -------------------------------------------------------------------
APP_NAME=AIPCC
ENVIRONMENT=local
DEBUG=false

# --- Database --------------------------------------------------------------
# Postgres runs in Docker locally (see docker-compose.yml). These three are
# read by the postgres container; DATABASE_URL is read by the backend.
POSTGRES_USER=aipcc
POSTGRES_PASSWORD=aipcc
POSTGRES_DB=aipcc

# Host-side default, for running the backend outside Docker. The compose file
# overrides the host to `postgres` inside the container, so you never need to
# change this to run the full stack.
DATABASE_URL=postgresql+psycopg://aipcc:aipcc@localhost:5432/aipcc

# --- Auth ------------------------------------------------------------------
# This default is fine for local work and is refused outside ENVIRONMENT=local.
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Brute-force protection ------------------------------------------------
# Two controls, and they are deliberately different in kind.
#
# Per source address: a hard lockout. This is what stops a flood — one host
# cannot get past LOGIN_IP_MAX_FAILURES guesses in the window.
#
# Per account: a progressive delay and *never* a lock. A per-account lockout
# would hand anyone a one-request denial of service against any address they
# can guess, so the account side only slows down: failure number
# LOGIN_DELAY_AFTER_FAILURES + 1 waits 2s, then 4s, then 8s, capped. The
# account stays answerable to whoever actually knows the password.
#
# State lives in Postgres, so it survives a restart and is correct across
# workers. Nothing expires it automatically: run `python -m app.db.prune`.
LOGIN_IP_MAX_FAILURES=5
LOGIN_IP_WINDOW_MINUTES=15
LOGIN_DELAY_AFTER_FAILURES=3
LOGIN_DELAY_MAX_SECONDS=8
REGISTER_IP_MAX_PER_HOUR=5
PASSWORD_CHANGE_MAX_FAILURES=5
PASSWORD_CHANGE_WINDOW_MINUTES=15
SHARE_IP_MAX_PER_MINUTE=60
AUTH_ATTEMPT_RETENTION_DAYS=30

# Set to true ONLY when a proxy in front of this app always overwrites
# X-Forwarded-For. The header is caller-supplied: trusting it without such a
# proxy lets an attacker rotate a header value to get unlimited attempts, and
# lets anyone lock out somebody else's address by claiming it.
TRUST_PROXY_HEADER=false

# Turns both controls off. For debugging only — never in a deployment.
RATE_LIMIT_ENABLED=true

# --- LLM -------------------------------------------------------------------
# One of: gemini | ollama | groq. Default gemini — runnable with a single key.
LLM_PROVIDER=gemini
# Low by design: this is structured extraction from logs, not creative writing.
LLM_TEMPERATURE=0.2

# Required only to generate a new report. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required when LLM_PROVIDER=groq. Also used by the n8n orchestrator.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=ollama (the local / data-sovereignty option).
# Inside docker compose this must not be `localhost` — that is the container.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Observability ---------------------------------------------------------
# LOG_FORMAT=auto means JSON everywhere except ENVIRONMENT=local, where a human
# is reading the terminal. Pin it to json or console to override.
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Tracing is off by default on purpose: the console exporter prints a span dump
# per span, which makes `docker compose up` unreadable. Turn it on to see a
# report generation as one trace with five concurrent LLM spans:
#
#   OTEL_ENABLED=true
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#   docker compose --profile tracing up      # then http://localhost:16686
#
# Leave the endpoint empty and enabled spans go to the console instead.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aipcc-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- LLM cost accounting ---------------------------------------------------
# Prices are configuration because they change without notice and differ per
# account. The built-in table covers the models named above; override it here
# as JSON, in USD per *million* tokens (the unit every provider publishes, so a
# value can be pasted off a pricing page unconverted):
#
#   LLM_PRICES={"gemini-2.5-flash":{"input_usd_per_1m":0.3,"output_usd_per_1m":2.5}}
#
# A model absent from the table costs `null`, never `0` — "nobody told this
# system what it costs" is not "free", and the dashboard renders it as `—`.
# Verify the defaults against the provider's pricing page before quoting any
# figure this app produces.
# LLM_PRICES=

# --- Evaluation gate -------------------------------------------------------
# What `python -m app.eval.run --gate` enforces, and what CI runs on every
# push. Deliberately not set to perfection: a gate that fails on its first
# honest run gets deleted. These sit where the recorded baseline sits, so a
# regression trips them and normal variation does not. See backend/EVAL.md.
EVAL_MAX_HALLUCINATION_RATE=0.10
EVAL_MIN_GROUNDING_RATE=0.80
EVAL_MIN_SECTION_SUCCESS_RATE=0.80

# --- RAG / vector store ----------------------------------------------------
CHROMA_COLLECTION=AIPCC_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=1000
CHUNK_OVERLAP=0

# CHROMA_DIR and UPLOAD_DIR are deliberately absent. Their defaults are
# absolute paths anchored to backend/, and a relative value here would resolve
# against whatever directory the process happened to start in — which is the
# class of silent config bug this project has already paid for twice. The
# compose file sets both explicitly for the container.

# Optional. Only needed for gated/private Hugging Face models; the default
# MiniLM model is public and works without a token.
HF_TOKEN=

# --- CORS ------------------------------------------------------------------
# Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Sharing ---------------------------------------------------------------
# Where a report share link points. This is the *frontend* origin: a share URL
# is opened by a person in a browser.
SHARE_BASE_URL=http://localhost:5173

# --- Threat intel (n8n workflows) ------------------------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
