# AIPCC configuration. Copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored. Never commit real values.
# Every variable here is read in exactly one place: backend/app/core/config.py.

# --- App -------------------------------------------------------------------
APP_NAME=AIPCC
ENVIRONMENT=local
DEBUG=false

# --- Database --------------------------------------------------------------
# Postgres runs in Docker locally (see docker-compose.yml). These three are
# read by the postgres container; DATABASE_URL is read by the backend.
POSTGRES_USER=aipcc
POSTGRES_PASSWORD=aipcc
POSTGRES_DB=aipcc

# Host-side default. Inside docker compose the backend overrides the host to
# `postgres`, so you do not need to change this to run the full stack.
DATABASE_URL=postgresql+psycopg://aipcc:aipcc@localhost:5432/aipcc

# --- Auth (used from Phase 2) ----------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM -------------------------------------------------------------------
# One of: gemini | ollama | groq. Default gemini — runnable with a single key.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.7

# Required when LLM_PROVIDER=gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required when LLM_PROVIDER=groq. Also used by the n8n orchestrator.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=ollama (the local / data-sovereignty option).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- RAG / vector store ----------------------------------------------------
CHROMA_DIR=./chroma_langchain_db
CHROMA_COLLECTION=AIPCC_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=1000
CHUNK_OVERLAP=0

# Optional. Only needed for gated/private Hugging Face models; the default
# MiniLM model is public and works without a token.
HF_TOKEN=

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads

# --- CORS ------------------------------------------------------------------
# Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Threat intel (used from Phase 5) --------------------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
